{
  "name": "dsh-cyrene",
  "version": "0.6.2",
  "description": "DeepSeek Harness 插件：增加「昔涟聊天模式」「德谬歌工作模式」两套 agent 预设——整份替换系统提示词进行角色对话，并附带随包世界书（61 条设定，按触发词自动注入）、长期记忆（remember / forget）、可配置称呼、表达风格档位与角色扮演场景；联网搜索保留，表情包需另装 dsh-meme。随包人设文本与世界书数据整理自开源项目 Cyrene-Agent（MIT）。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Cyrene-xl",
  "contributors": [
    { "name": "YOGEMOW", "url": "https://github.com/YOGEMOW" }
  ],
  "repository": { "type": "git", "url": "git+https://github.com/YOGEMOW/DSH-Cyrene.git" },
  "upstream": { "type": "git", "url": "https://github.com/Cyrene-xl/DSH-Cyrene.git" },
  "bugs": { "url": "https://github.com/YOGEMOW/DSH-Cyrene/issues" },
  "homepage": "https://github.com/YOGEMOW/DSH-Cyrene#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "deepseek", "dsh", "agent-preset", "persona", "chat"],
  "files": [
    "index.js", "memory.js", "nickname.js", "worldbook/", "styles/", "style.js", "scene.js",
    "cordis.patch.yml", "plugin.json", "dsh.plugin.json", "preset/", "scripts/", "docs/",
    "README.md", "README.technical.md", "LICENSES/", "LICENSE", "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./index.js",
    "./memory": "./memory.js",
    "./nickname": "./nickname.js",
    "./worldbook": "./worldbook/index.mjs",
    "./worldbook/": "./worldbook/",
    "./plugin.json": "./plugin.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./style": "./style.js",
    "./scene": "./scene.js"
  },
  "dsh": {
    "id": "dsh-cyrene",
    "name": "昔涟（Cyrene）",
    "displayName": "昔涟（Cyrene）",
    "version": "0.6.2",
    "repo": "YOGEMOW/DSH-Cyrene",
    "permissions": "不在运行时申请任何权限",
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "test": "node --test \"tests/*.mjs\"",
    "harness:check": "node --check index.js && node --check memory.js && node --check nickname.js && node --check style.js && node --check scene.js && node --check worldbook/index.mjs && node --check worldbook/parse.mjs && node --check worldbook/match.mjs && node --check worldbook/assemble.mjs && node --check scripts/build-bundle-patch.mjs",
    "build:patch": "node scripts/build-bundle-patch.mjs",
    "check:patch": "node scripts/build-bundle-patch.mjs --check",
    "install:preset": "node scripts/install.mjs"
  },
  "engines": { "node": ">=22" }
}
